# ─────────────────────────────────────────────────────────────────────────────
# NSAP Eligibility Predictor — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# IBM Cloud API Key (used to obtain IAM bearer tokens)
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here

# IBM watsonx.ai project ID
PROJECT_ID=your-watsonx-project-id-here

# IBM watsonx.ai text generation endpoint
WATSONX_AI_ENDPOINT=https://eu-de.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# IBM watsonx Orchestrate instance URL
WXO_INSTANCE_URL=https://api.eu-de.watson-orchestrate.ibm.com

# Granite model ID
MODEL_ID=ibm/granite-4-h-small
